# Application and demo seed runtime (Supabase transaction pooler)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DATABASE_SCHEMA="public"

# Application and demo migrations (direct connection or Supabase session pooler)
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres?schema=public"

# Auth.js secret used to encrypt and sign JWT sessions.
AUTH_SECRET="replace-with-a-random-secret"

# Server-only password assigned to seeded users and used by demo account login.
SEED_USER_PASSWORD="replace-with-a-local-development-password"
