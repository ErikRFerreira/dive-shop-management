# Main application runtime (Supabase transaction pooler)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DATABASE_SCHEMA="public"

# Main Prisma migrations (direct connection or Supabase session pooler)
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres?schema=public"

# Demo seed runtime (schema is selected explicitly by the seed script)
DEMO_DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"

# Optional demo migrations; falls back to DIRECT_URL and always forces schema=demo
DEMO_DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres"

# Auth.js secret used to encrypt and sign JWT sessions.
AUTH_SECRET="replace-with-a-random-secret"

# Shared local-only password assigned to development users by the seed script.
SEED_USER_PASSWORD="replace-with-a-local-development-password"

# Optional email-only seed account selector for `next dev`; keep disabled by default.
ENABLE_DEV_ACCOUNT_SELECTOR="false"
